;; generator.fe (Run from demo/ directory)
(do-file "common.fe")
(do-file "dsp.fe")

;; 1. Global list to record calls
(= gen-data nil)
(func gen-record (x) (= gen-data (cons x gen-data)))

;; 2. Mock UI and critical callbacks
(func ui:row args nil) (func ui:label args nil) (func ui:button args nil) 
(func ui:meter args 0) (func ui:number (l v) v) (func ui:highlight () nil) 
(func ui:key-pressed (k) nil) (func ui:scope (n p) nil)
(func ui:begin-column args nil) (func ui:end-column args nil)
(func ui:push-id args nil) (func ui:pop-id args nil)
(func ui:slider (lbl val . rest) val)

;; Prevent callbacks from executing during load
(func on-tick () nil)
(func on-midi args nil)

;; 3. Shadow DSP
(= original-dsp-new dsp:new)
(= dsp:new (fn (type)
  (let id (original-dsp-new type))
  (gen-record (list 'new type id))
  id))

(= original-dsp-link dsp:link)
(= dsp:link (fn (n1 o n2 i)
  (gen-record (list 'link n1 o n2 i))
  (original-dsp-link n1 o n2 i)))

(= original-dsp-set dsp:set)
(= dsp:set (fn (n i v)
  (gen-record (list 'set n i v))
  (original-dsp-set n i v)))

(= original-dsp-send dsp:send)
(= dsp:send (fn (n s)
  (gen-record (list 'send n s))
  (original-dsp-send n s)))

;; 4. Run the main logic
(do-file "main.fe")

;; Capture initial state of the graph parameters
(on-frame)

;; 5. Output C Code
(echo "#include <stdio.h>")
(echo "#include \"dsp/dsp.h\"")
(echo "#include \"dsp/node.h\"")
(echo "")

(for item (rev gen-data)
  (if (is (car item) 'new)
    (echo (string "static int node_" (nth 2 item) ";"))))

(echo "void setup_graph(void) {")
(echo "  char err_buf[NODE_MAX_ERROR];")
(for item (rev gen-data)
  (case (car item)
    'new (echo (string "  node_" (nth 2 item) " = dsp_new_node(\"" (nth 1 item) "\");"))
    'link (echo (string "  node_link(dsp_get_node(node_" (nth 1 item) "), \"" (nth 2 item) "\", dsp_get_node(node_" (nth 3 item) "), \"" (nth 4 item) "\");"))
    'set (echo (string "  node_set(dsp_get_node(node_" (nth 1 item) "), \"" (nth 2 item) "\", (float)(" (nth 3 item) "));"))
    'send (echo (string "  if (node_receive(dsp_get_node(node_" (nth 1 item) "), \"" (nth 2 item) "\", err_buf)) printf(\"Error on node_" (nth 1 item) " send: %s\\n\", err_buf);"))
  )
)
(echo "}")

;; Sequence export
(let s (or (read "save1") seq))
(echo "int sequence_data[16][12] = {")
(for i (range 16)
  (let row "{ ")
  (for v-set s
    (let ptn (nth (car v-set) v-set))
    (let step (nth i ptn))
    (let note (or (and step (abs step)) 0))
    (let acc (if (and step (< step 0)) 1 0))
    (set row (string row note ", " acc ", "))
  )
  (echo (string "  " row "},"))
)
(echo "};")

(echo "#include <math.h>")
(echo "static float mtof(int note) { return 440.0f * powf(2.0f, (note - 69) / 12.0f); }")

(echo "void trigger_voice1(int n, int a) {")
(echo "  char buf[128]; char err[256];")
(echo "  if (n) {")
(echo "    sprintf(buf, \"begin %f %f\", mtof(n), a ? 0.1f : 0.0f);")
(echo "    node_receive(dsp_get_node(node_7), buf, err);")
(echo "    node_receive(dsp_get_node(node_9), \"begin 0.7 0.005 0 0.5\", err);")
(echo "    node_receive(dsp_get_node(node_12), \"begin 0.4 0.005 0 0.5\", err);")
(echo "    node_set(dsp_get_node(node_10), \"q\", 30.0f * powf(0.3f, 5.0f));")
(echo "  }")
(echo "}")

(echo "void trigger_voice2(int n, int a) {")
(echo "  char buf[128]; char err[256];")
(echo "  if (n) {")
(echo "    sprintf(buf, \"begin %f %f\", mtof(n), a ? 0.1f : 0.0f);")
(echo "    node_receive(dsp_get_node(node_16), buf, err);")
(echo "    node_receive(dsp_get_node(node_18), \"begin 0.7 0.005 0 0.5\", err);")
(echo "    node_receive(dsp_get_node(node_21), \"begin 0.4 0.005 0 0.5\", err);")
(echo "    node_set(dsp_get_node(node_19), \"q\", 30.0f * powf(0.3f, 5.0f));")
(echo "  }")
(echo "}")

(func echo-drum (id env amp-env)
  (echo (string "void trigger_voice" id "(int n, int a) {"))
  (echo "  char buf[128]; char err[256];")
  (echo "  if (n) {")
  (echo "    sprintf(buf, \"begin %f 0.005 0 0.5\", 0.7f * (a ? 1.3f : 1.0f));")
  (echo (string "    node_receive(dsp_get_node(node_" amp-env "), buf, err);"))
  (echo (string "    node_receive(dsp_get_node(node_" env "), \"begin 0.25 0.005 0 0.5\", err);"))
  (echo "  }")
  (echo "}")
)
(echo-drum 3 26 30)
(echo-drum 4 35 39)
(echo-drum 5 44 48)
(echo-drum 6 53 57)

(exit)
